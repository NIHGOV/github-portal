{
  "typescript.tsdk": "node_modules/typescript/lib",
  "chat.tools.terminal.autoApprove": {
    "npm install": true,
    "npx tsc": true,
    "diff": true,
    "awk": true,
    "/^git show ORIG_HEAD:tsconfig\\.json \\| python3 -c \"import sys,json; d=json\\.load\\(sys\\.stdin\\); co=d\\.get\\('compilerOptions',\\{\\}\\); print\\('module:', co\\.get\\('module'\\)\\); print\\('moduleResolution:', co\\.get\\('moduleResolution'\\)\\)\"$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "uniq": true
  }
}
